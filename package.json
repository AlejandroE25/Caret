{
  "name": "caret-app",
  "private": true,
  "scripts": {
    "test": "node --test",
    "build:app": "bash scripts/build-app.sh",
    "install:app": "bash scripts/install-app.sh",
    "theme:package": "cd theme && npm run package",
    "icon": "sh scripts/apply-icon.sh",
    "icon:reset": "sh scripts/apply-icon.sh --reset",
    "icon:render": "osascript -l JavaScript scripts/render-icon.js \"$PWD/assets/app-icon.svg\" \"$PWD/assets/app-icon.png\"",
    "templates": "node scripts/build-templates.js"
  }
}
