{
  "name": "caret",
  "displayName": "Caret",
  "description": "A dark VS Code theme in the iKB design language: flat #262626, blue panel headers, square corners.",
  "version": "0.2.0",
  "publisher": "alejandroe25",
  "license": "UNLICENSED",
  "icon": "icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/AlejandroE25/Caret.git"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Themes"
  ],
  "contributes": {
    "themes": [
      {
        "label": "Caret",
        "uiTheme": "vs-dark",
        "path": "./themes/caret-color-theme.json"
      }
    ]
  },
  "scripts": {
    "test": "node --test",
    "package": "npx @vscode/vsce package --skip-license",
    "icon": "sh scripts/apply-icon.sh",
    "icon:reset": "sh scripts/apply-icon.sh --reset",
    "icon:render": "osascript -l JavaScript scripts/render-icon.js \"$PWD/assets/app-icon.svg\" \"$PWD/assets/app-icon.png\""
  }
}
