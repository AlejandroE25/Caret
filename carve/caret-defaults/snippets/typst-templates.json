      "",
      "#show: notes.with(",
      "  course: \"${1:CS 173}\",",
      "  lecture: ${2:1},",
      "  date: datetime(year: $CURRENT_YEAR, month: $CURRENT_MONTH, day: $CURRENT_DATE),",
      ")",
      "",
      "= ${3:Topic}",
      "$0"
    ]
  },
  "Week of notes, one #session per day": {
    "prefix": "template-notes-week",
    "description": "manuscript notes-week template",
    "isFileTemplate": true,
    "body": [
      "#import \"@local/manuscript:0.20.0\" as manuscript: *",
      "",
      "#show: notes.with(",
      "  course: \"${1:CS 173}\",",
      "  week: ${2:1},",
      "  date: datetime(year: $CURRENT_YEAR, month: $CURRENT_MONTH, day: $CURRENT_DATE),",
      ")",
      "",
      "#session(datetime(year: $CURRENT_YEAR, month: $CURRENT_MONTH, day: $CURRENT_DATE), title: [${3:Topic}])",
      "",
      "= ${4:Topic}",
      "$0"
    ]
  }
}
