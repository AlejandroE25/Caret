{
  "$schema": "vscode://schemas/color-theme",
  "name": "Caret",
  "type": "dark",
  "semanticHighlighting": true,
  "colors": {
    // base
    "foreground": "#cccccc",
    "descriptionForeground": "#999999",
    "disabledForeground": "#777777",
    "errorForeground": "#e08080",
    "icon.foreground": "#cccccc",
    "focusBorder": "#7aaee8",
    "selection.background": "#3c5070",
    "widget.border": "#444444",
    // flat: borders separate floating widgets, not shadows
    "widget.shadow": "#00000000",
    "scrollbar.shadow": "#00000000",
    "textLink.foreground": "#7aaee8",
    "textLink.activeForeground": "#aaccff",
    "textPreformat.foreground": "#aaccff",
    "textPreformat.background": "#1e1e1e",
    "textBlockQuote.background": "#2e2e2e",
    "textBlockQuote.border": "#3c5070",
    "textCodeBlock.background": "#1e1e1e",
    "textSeparator.foreground": "#555555",
    "progressBar.background": "#7aaee8",
    "badge.background": "#3c5070",
    "badge.foreground": "#ffffff",
    "banner.background": "#3c5070",
    "banner.foreground": "#ffffff",

    // title bar: the 2px --rule under the iKB header
    "titleBar.activeBackground": "#262626",
    "titleBar.activeForeground": "#cccccc",
    "titleBar.inactiveBackground": "#262626",
    "titleBar.inactiveForeground": "#777777",
    "titleBar.border": "#555555",
    "menubar.selectionBackground": "#3a3a3a",
    "menubar.selectionForeground": "#e0e0e0",

    // activity bar
    "activityBar.background": "#262626",
    "activityBar.foreground": "#e0e0e0",
    "activityBar.inactiveForeground": "#777777",
    "activityBar.border": "#444444",
    "activityBar.activeBorder": "#7aaee8",
    "activityBar.activeBackground": "#2e2e2e",
    "activityBarBadge.background": "#3c5070",
    "activityBarBadge.foreground": "#ffffff",
    "activityBarTop.foreground": "#e0e0e0",
    "activityBarTop.inactiveForeground": "#777777",
    "activityBarTop.activeBorder": "#7aaee8",

    // sidebar: iKB panel headers are blue bars with white bold text
    "sideBar.background": "#262626",
    "sideBar.foreground": "#cccccc",
    "sideBar.border": "#444444",
    "sideBar.dropBackground": "#3c507080",
    "sideBarTitle.background": "#262626",
    "sideBarTitle.foreground": "#e0e0e0",
    "sideBarSectionHeader.background": "#3c5070",
    "sideBarSectionHeader.foreground": "#ffffff",
    "sideBarSectionHeader.border": "#444444",
    "sideBarStickyScroll.shadow": "#00000000",

    // lists and trees
    "list.activeSelectionBackground": "#3c5070",
    "list.activeSelectionForeground": "#ffffff",
    "list.activeSelectionIconForeground": "#ffffff",
    "list.inactiveSelectionBackground": "#3a3a3a",
    "list.inactiveSelectionForeground": "#e0e0e0",
    "list.hoverBackground": "#2e2e2e",
    "list.hoverForeground": "#e0e0e0",
    "list.focusOutline": "#7aaee8",
    "list.inactiveFocusOutline": "#555555",
    "list.highlightForeground": "#7aaee8",
    "list.focusHighlightForeground": "#aaccff",
    "list.errorForeground": "#e08080",
    "list.warningForeground": "#e0a060",
    "list.invalidItemForeground": "#e08080",
    "list.dropBackground": "#3c507080",
    "tree.indentGuidesStroke": "#555555",
    "tree.inactiveIndentGuidesStroke": "#444444",
    "listFilterWidget.background": "#2e2e2e",
    "listFilterWidget.outline": "#7aaee8",
    "listFilterWidget.noMatchesOutline": "#e08080",

    // editor
    "editor.background": "#262626",
    "editor.foreground": "#cccccc",
    "editorLineNumber.foreground": "#777777",
    "editorLineNumber.activeForeground": "#e0e0e0",
    "editorCursor.foreground": "#7aaee8",
    "editor.selectionBackground": "#3c5070",
    "editor.inactiveSelectionBackground": "#3c507080",
    "editor.selectionHighlightBackground": "#3c507066",
    "editor.wordHighlightBackground": "#3c507066",
    "editor.wordHighlightStrongBackground": "#3c507099",
    "editor.findMatchBackground": "#6a4020",
    "editor.findMatchBorder": "#e0a060",
    "editor.findMatchHighlightBackground": "#3a2010",
    "editor.lineHighlightBackground": "#2e2e2e",
    "editor.rangeHighlightBackground": "#3c507033",
    "editorWhitespace.foreground": "#444444",
    "editorIndentGuide.background1": "#3a3a3a",
    "editorIndentGuide.activeBackground1": "#555555",
    "editorRuler.foreground": "#3a3a3a",
    "editorBracketMatch.background": "#3c507066",
    "editorBracketMatch.border": "#7aaee8",
    "editorBracketHighlight.foreground1": "#7aaee8",
    "editorBracketHighlight.foreground2": "#e0a060",
    "editorBracketHighlight.foreground3": "#6ec86e",
    "editorLink.activeForeground": "#aaccff",
    "editorCodeLens.foreground": "#777777",
    "editorError.foreground": "#e08080",
    "editorWarning.foreground": "#e0a060",
    "editorInfo.foreground": "#7aaee8",
    "editorHint.foreground": "#6ec86e",
    "editorGutter.background": "#262626",
    "editorGutter.addedBackground": "#6ec86e",
    "editorGutter.modifiedBackground": "#7aaee8",
    "editorGutter.deletedBackground": "#e08080",
    "editorOverviewRuler.border": "#444444",
    "editorOverviewRuler.errorForeground": "#e08080",
    "editorOverviewRuler.warningForeground": "#e0a060",
    "editorOverviewRuler.infoForeground": "#7aaee8",
    "editorStickyScroll.background": "#262626",
    "editorStickyScrollHover.background": "#2e2e2e",
    "editorStickyScroll.shadow": "#00000000",

    // editor widgets: --surface, like iKB panels
    "editorWidget.background": "#2e2e2e",
    "editorWidget.foreground": "#cccccc",
    "editorWidget.border": "#444444",
    "editorHoverWidget.background": "#2e2e2e",
    "editorHoverWidget.border": "#444444",
    "editorSuggestWidget.background": "#2e2e2e",
    "editorSuggestWidget.border": "#444444",
    "editorSuggestWidget.foreground": "#cccccc",
    "editorSuggestWidget.selectedBackground": "#3c5070",
    "editorSuggestWidget.selectedForeground": "#ffffff",
    "editorSuggestWidget.highlightForeground": "#7aaee8",
    "editorSuggestWidget.focusHighlightForeground": "#aaccff",
    "peekView.border": "#7aaee8",
    "peekViewTitle.background": "#3c5070",
    "peekViewTitleLabel.foreground": "#ffffff",
    "peekViewTitleDescription.foreground": "#e0e0e0",
    "peekViewEditor.background": "#1e1e1e",
    "peekViewEditor.matchHighlightBackground": "#6a4020",
    "peekViewResult.background": "#262626",
    "peekViewResult.selectionBackground": "#3c5070",
    "peekViewResult.selectionForeground": "#ffffff",
    "peekViewResult.matchHighlightBackground": "#6a4020",

    // editor groups and tabs
    "editorGroup.border": "#444444",
    "editorGroup.dropBackground": "#3c507066",
    "editorGroupHeader.tabsBackground": "#262626",
    "editorGroupHeader.tabsBorder": "#444444",
    "editorGroupHeader.noTabsBackground": "#262626",
    "tab.activeBackground": "#2e2e2e",
    "tab.activeForeground": "#e0e0e0",
    "tab.activeBorderTop": "#7aaee8",
    "tab.selectedBorderTop": "#7aaee8",
    "tab.inactiveBackground": "#262626",
    "tab.inactiveForeground": "#999999",
    "tab.border": "#444444",
    "tab.hoverBackground": "#2a2a2a",
    "tab.unfocusedActiveForeground": "#cccccc",
    "tab.unfocusedActiveBorderTop": "#555555",
    "tab.unfocusedInactiveForeground": "#999999",
    "tab.activeModifiedBorder": "#e0a060",
    "tab.inactiveModifiedBorder": "#6a4020",
    "breadcrumb.background": "#262626",
    "breadcrumb.foreground": "#999999",
    "breadcrumb.focusForeground": "#e0e0e0",
    "breadcrumb.activeSelectionForeground": "#e0e0e0",
    "breadcrumbPicker.background": "#2e2e2e",

    // panel (terminal, problems). VS Code has no panel title background key, so the tab strip stays --bg.
    "panel.background": "#262626",
    "panel.border": "#555555",
    "panelTitle.activeForeground": "#e0e0e0",
    "panelTitle.activeBorder": "#7aaee8",
    "panelTitle.inactiveForeground": "#999999",
    "panelTitleBadge.background": "#3c5070",
    "panelTitleBadge.foreground": "#ffffff",
    "panelSectionHeader.background": "#3c5070",
    "panelSectionHeader.foreground": "#ffffff",
    "panelSectionHeader.border": "#444444",
    "panelInput.border": "#555555",

    // status bar
    "statusBar.background": "#262626",
    "statusBar.foreground": "#999999",
    "statusBar.border": "#555555",
    "statusBar.noFolderBackground": "#262626",
    "statusBar.debuggingBackground": "#3a2010",
    "statusBar.debuggingForeground": "#e0a060",
    "statusBar.debuggingBorder": "#6a4020",
    "statusBarItem.hoverBackground": "#3c5070",
    "statusBarItem.hoverForeground": "#ffffff",
    "statusBarItem.focusBorder": "#7aaee8",
    "statusBarItem.remoteBackground": "#3c5070",
    "statusBarItem.remoteForeground": "#ffffff",
    "statusBarItem.prominentBackground": "#3c5070",
    "statusBarItem.prominentForeground": "#ffffff",
    "statusBarItem.errorBackground": "#3a1010",
    "statusBarItem.errorForeground": "#e08080",
    "statusBarItem.warningBackground": "#3a2010",
    "statusBarItem.warningForeground": "#e0a060",

    // inputs: Rubric input/select
    "input.background": "#1e1e1e",
    "input.foreground": "#cccccc",
    "input.border": "#555555",
    "input.placeholderForeground": "#777777",
    "inputOption.activeBackground": "#3c5070",
    "inputOption.activeBorder": "#7aaee8",
    "inputOption.activeForeground": "#ffffff",
    "inputValidation.errorBackground": "#3a1010",
    "inputValidation.errorBorder": "#6a2020",
    "inputValidation.errorForeground": "#e08080",
    "inputValidation.warningBackground": "#3a2010",
    "inputValidation.warningBorder": "#6a4020",
    "inputValidation.warningForeground": "#e0a060",
    "inputValidation.infoBackground": "#1e1e1e",
    "inputValidation.infoBorder": "#3c5070",
    "dropdown.background": "#1e1e1e",
    "dropdown.foreground": "#cccccc",
    "dropdown.border": "#555555",
    "dropdown.listBackground": "#2e2e2e",
    "checkbox.background": "#1e1e1e",
    "checkbox.foreground": "#cccccc",
    "checkbox.border": "#555555",
    "checkbox.selectBackground": "#2e2e2e",

    // buttons: Rubric .btn-primary and .btn
    "button.background": "#3c5070",
    "button.foreground": "#ffffff",
    "button.hoverBackground": "#46608a",
    "button.border": "#7aaee8",
    "button.separator": "#ffffff66",
    "button.secondaryBackground": "#3a3a3a",
    "button.secondaryForeground": "#cccccc",
    "button.secondaryHoverBackground": "#484848",

    // scrollbars
    "scrollbarSlider.background": "#55555580",
    "scrollbarSlider.hoverBackground": "#555555cc",
    "scrollbarSlider.activeBackground": "#7aaee880",

    // menus, quick pick, keybindings
    "menu.background": "#2e2e2e",
    "menu.foreground": "#cccccc",
    "menu.border": "#444444",
    "menu.selectionBackground": "#3c5070",
    "menu.selectionForeground": "#ffffff",
    "menu.separatorBackground": "#444444",
    "quickInput.background": "#2e2e2e",
    "quickInput.foreground": "#cccccc",
    "quickInputTitle.background": "#3c5070",
    "quickInputList.focusBackground": "#3c5070",
    "quickInputList.focusForeground": "#ffffff",
    "pickerGroup.foreground": "#7aaee8",
    "pickerGroup.border": "#444444",
    "keybindingLabel.background": "#3a3a3a",
    "keybindingLabel.foreground": "#e0e0e0",
    "keybindingLabel.border": "#555555",
    "keybindingLabel.bottomBorder": "#444444",

    // notifications: Rubric toasts
    "notifications.background": "#2e2e2e",
    "notifications.foreground": "#cccccc",
    "notifications.border": "#444444",
    "notificationCenter.border": "#444444",
    "notificationToast.border": "#444444",
    "notificationCenterHeader.background": "#3c5070",
    "notificationCenterHeader.foreground": "#ffffff",
    "notificationLink.foreground": "#7aaee8",
    "notificationsErrorIcon.foreground": "#e08080",
    "notificationsWarningIcon.foreground": "#e0a060",
    "notificationsInfoIcon.foreground": "#7aaee8",

    // source control
    "gitDecoration.addedResourceForeground": "#6ec86e",
    "gitDecoration.untrackedResourceForeground": "#6ec86e",
    "gitDecoration.renamedResourceForeground": "#6ec86e",
    "gitDecoration.modifiedResourceForeground": "#e0a060",
    "gitDecoration.stageModifiedResourceForeground": "#e0a060",
    "gitDecoration.deletedResourceForeground": "#e08080",
    "gitDecoration.stageDeletedResourceForeground": "#e08080",
    "gitDecoration.conflictingResourceForeground": "#e08080",
    "gitDecoration.ignoredResourceForeground": "#777777",
    "gitDecoration.submoduleResourceForeground": "#aaccff",
    "diffEditor.insertedTextBackground": "#6ec86e26",
    "diffEditor.removedTextBackground": "#e0808026",
    "diffEditor.insertedLineBackground": "#1a3a1a80",
    "diffEditor.removedLineBackground": "#3a101080",
    "diffEditor.border": "#444444",
    "diffEditor.diagonalFill": "#444444",

    // terminal. Magenta and cyan are not in the iKB palette, so they are derived at the same lightness.
    "terminal.background": "#1e1e1e",
    "terminal.foreground": "#cccccc",
    "terminal.border": "#444444",
    "terminal.selectionBackground": "#3c5070",
    "terminalCursor.foreground": "#7aaee8",
    "terminal.ansiBlack": "#3a3a3a",
    "terminal.ansiRed": "#e08080",
    "terminal.ansiGreen": "#6ec86e",
    "terminal.ansiYellow": "#e0a060",
    "terminal.ansiBlue": "#7aaee8",
    "terminal.ansiMagenta": "#c8a0e0",
    "terminal.ansiCyan": "#80c8c8",
    "terminal.ansiWhite": "#cccccc",
    "terminal.ansiBrightBlack": "#777777",
    "terminal.ansiBrightRed": "#f0a0a0",
    "terminal.ansiBrightGreen": "#90e090",
    "terminal.ansiBrightYellow": "#f0c080",
    "terminal.ansiBrightBlue": "#aaccff",
    "terminal.ansiBrightMagenta": "#e0c0f0",
    "terminal.ansiBrightCyan": "#a0e0e0",
    "terminal.ansiBrightWhite": "#ffffff",

    // misc views
    "debugToolBar.background": "#2e2e2e",
    "debugToolBar.border": "#444444",
    "settings.headerForeground": "#e0e0e0",
    "settings.modifiedItemIndicator": "#7aaee8",
    "settings.focusedRowBackground": "#2e2e2e",
    "welcomePage.tileBackground": "#2e2e2e",
    "welcomePage.tileBorder": "#444444",
    "minimap.selectionHighlight": "#3c5070"
  },
  "tokenColors": [
    { "scope": "comment", "settings": { "foreground": "#777777", "fontStyle": "italic" } },
    { "scope": ["keyword", "storage", "storage.type", "keyword.operator.new", "keyword.operator.expression"], "settings": { "foreground": "#7aaee8" } },
    { "scope": ["string", "string.quoted", "markup.inline.raw.string"], "settings": { "foreground": "#6ec86e" } },
    { "scope": ["constant.numeric", "constant.language", "constant.character", "constant.other", "string.regexp", "variable.other.constant"], "settings": { "foreground": "#e0a060" } },
    { "scope": ["entity.name.type", "entity.name.class", "support.type", "support.class", "entity.other.inherited-class"], "settings": { "foreground": "#aaccff" } },
    { "scope": ["entity.name.function", "support.function"], "settings": { "foreground": "#c8a0e0" } },
    { "scope": ["entity.name.tag"], "settings": { "foreground": "#7aaee8" } },
    { "scope": ["entity.other.attribute-name"], "settings": { "foreground": "#e0a060" } },
    { "scope": ["punctuation", "meta.brace"], "settings": { "foreground": "#999999" } },
    { "scope": ["invalid", "invalid.illegal"], "settings": { "foreground": "#e08080" } },
    { "scope": ["markup.heading", "entity.name.section"], "settings": { "foreground": "#7aaee8", "fontStyle": "bold" } },
    { "scope": "markup.bold", "settings": { "foreground": "#e0e0e0", "fontStyle": "bold" } },
    { "scope": "markup.italic", "settings": { "fontStyle": "italic" } },
    { "scope": ["markup.inline.raw", "markup.fenced_code"], "settings": { "foreground": "#aaccff" } },
    { "scope": "markup.underline.link", "settings": { "foreground": "#7aaee8" } },
    { "scope": "markup.inserted", "settings": { "foreground": "#6ec86e" } },
    { "scope": "markup.deleted", "settings": { "foreground": "#e08080" } },
    { "scope": "markup.changed", "settings": { "foreground": "#e0a060" } },
    { "scope": ["markup.raw", "markup.other.raw.typst"], "settings": { "foreground": "#aaccff" } },
    { "scope": ["markup.math.typst"], "settings": { "foreground": "#80c8c8" } },
    { "scope": ["string.other.label.typst", "string.other.reference.typst", "string.other.link.title.typst", "string.other.link.typst", "entity.name.label.typst"], "settings": { "foreground": "#e0a060" } },
    { "scope": ["markup.list.typst", "punctuation.definition.list"], "settings": { "foreground": "#7aaee8" } },
    { "scope": ["markup.list.term.typst"], "settings": { "foreground": "#e0e0e0", "fontStyle": "bold" } },
    { "scope": ["entity.name.function.hash.typst"], "settings": { "foreground": "#c8a0e0" } }
  ]
}
